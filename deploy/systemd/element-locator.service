# 元素定位器服务（systemd）
# 注意：元素抓取需要 adb + USB 真机接在服务器上；无真机时服务可运行但无法抓元素
[Unit]
Description=AutomationTest Element Locator (:8001)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/AutomationTest
ExecStart=/opt/AutomationTest/.venv/bin/python element_locator/server.py
Restart=always
RestartSec=3
Environment=PYTHONIOENCODING=utf-8

[Install]
WantedBy=multi-user.target
